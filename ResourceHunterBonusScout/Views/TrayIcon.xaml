<tb:TaskbarIcon x:Class="ResourceHunterBonusScout.Views.TrayIcon"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
                IconSource="{Binding Status.IconState, Converter={StaticResource IconStateToImage}}"
                ToolTipText="{Binding Status, Converter={StaticResource StatusToToolTip}}"
                MenuActivation="LeftOrRightClick">
    <tb:TaskbarIcon.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Settings…" Command="{Binding ShowSettingsCommand}" />
            <MenuItem Header="Open log" Command="{Binding OpenLogCommand}" />
            <Separator />
            <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
        </ContextMenu>
    </tb:TaskbarIcon.ContextMenu>
</tb:TaskbarIcon>
