<Window x:Class="ResourceHunterBonusScout.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ResourceHunterBonusScout.ViewModels;assembly=ResourceHunterBonusScout.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="Resource Hunter Bonus Scout" Icon="/Assets/Active.ico"
        Width="680" Height="760" MinWidth="480" MinHeight="420" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Step" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="Screenshot" TargetType="Image">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="18,4,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" IsDefault="True" Command="{Binding SaveCommand}" MinWidth="80" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" MinWidth="80" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Label Content="_API key" Target="{Binding ElementName=ApiKeyPasswordBox}" Padding="0,0,0,4" FontWeight="SemiBold" />
            <DockPanel>
                <CheckBox DockPanel.Dock="Right" Content="Show" IsChecked="{Binding IsApiKeyVisible}" VerticalAlignment="Center" Margin="8,0,0,0" />
                <Grid>
                    <PasswordBox x:Name="ApiKeyPasswordBox" Padding="4" PasswordChanged="OnPasswordChanged"
                                 Visibility="{Binding IsApiKeyVisible, Converter={StaticResource VisibleWhenFalse}}" />
                    <TextBox Padding="4" Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsApiKeyVisible, Converter={StaticResource VisibleWhenTrue}}" />
                </Grid>
            </DockPanel>
            <TextBlock Text="The API key must start with fz_live_" Foreground="Firebrick" Margin="0,4,0,0"
                       Visibility="{Binding IsApiKeyRejected, Converter={StaticResource VisibleWhenTrue}}" />
            <CheckBox Content="Start with _Windows" IsChecked="{Binding StartWithWindows}" Margin="0,12,0,0" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock>
                    Resource Hunter Bonus Scout watches your EverQuest logs and reports each zone's Resource Hunter bonus
                    to the community site as you travel. Every player who runs it helps fill in the day's bonus map for everyone.
                    It runs in the system tray.
                </TextBlock>

                <TextBlock Style="{StaticResource Step}">
                    <Bold>1. Turn on logging:</Bold> type <Run FontFamily="Consolas">/log on</Run> in EverQuest.
                </TextBlock>

                <TextBlock Style="{StaticResource Step}">
                    <Bold>2. Get an API key:</Bold> open
                    <Hyperlink NavigateUri="https://fangbreaker.zone" RequestNavigate="OnRequestNavigate">fangbreaker.zone</Hyperlink> or
                    <Hyperlink NavigateUri="https://frostreaver.zone" RequestNavigate="OnRequestNavigate">frostreaver.zone</Hyperlink>
                    and log in with Discord. One key works on both sites. Open the menu under your name and choose <Bold>Account</Bold>.
                </TextBlock>
                <Image Source="/Assets/account-menu.png" Style="{StaticResource Screenshot}" Width="260" />

                <TextBlock Margin="0,8,0,4">
                    The page is titled <Bold>Client API Key</Bold>. Click <Bold>Generate API Key</Bold>.
                </TextBlock>
                <Image Source="/Assets/api-key-generate.png" Style="{StaticResource Screenshot}" MaxWidth="560" />

                <TextBlock Margin="0,8,0,4">
                    Then click <Bold>Copy</Bold>.
                </TextBlock>
                <Image Source="/Assets/api-key-copy.png" Style="{StaticResource Screenshot}" MaxWidth="560" />

                <TextBlock Margin="0,8,0,0">
                    An account has only one key, shared with fzClient. If you already have a key in fzClient, paste that one.
                    <Bold>Rotate API Key</Bold> shows a new key, but the old one stops working in fzClient.
                </TextBlock>

                <TextBlock Style="{StaticResource Step}">
                    <Bold>3. Paste the key below</Bold> and click <Bold>Save</Bold>.
                </TextBlock>

                <TextBlock Margin="0,24,0,0" FontSize="11" Foreground="Gray">
                    Icons:
                    <Hyperlink NavigateUri="https://thenounproject.com/icon/search-8113129/" RequestNavigate="OnRequestNavigate">Search</Hyperlink>
                    by SHAKA FAHMI and
                    <Hyperlink NavigateUri="https://thenounproject.com/icon/error-1000339/" RequestNavigate="OnRequestNavigate">Error</Hyperlink>
                    by Gregor Cresnar from
                    <Hyperlink NavigateUri="https://thenounproject.com/" RequestNavigate="OnRequestNavigate">Noun Project</Hyperlink>
                    (<Hyperlink NavigateUri="https://creativecommons.org/licenses/by/3.0/" RequestNavigate="OnRequestNavigate">CC BY 3.0</Hyperlink>), recolored.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
