<Window x:Class="ResourceHunterBonusScout.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ResourceHunterBonusScout.ViewModels;assembly=ResourceHunterBonusScout.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="Resource Hunter Bonus Scout" Icon="/Assets/Active.ico"
        Width="520" SizeToContent="Height" MinWidth="420" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" IsDefault="True" Command="{Binding SaveCommand}" MinWidth="80" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" MinWidth="80" />
        </StackPanel>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="_API key" Target="{Binding ElementName=ApiKeyPasswordBox}" Padding="0,0,0,4" FontWeight="SemiBold" />
                <TextBlock Margin="4,0,0,0">
                    (<Hyperlink NavigateUri="https://github.com/JayBazuzi/ResourceHunterBonusScout#readme" RequestNavigate="OnRequestNavigate">help</Hyperlink>)
                </TextBlock>
            </StackPanel>
            <DockPanel>
                <CheckBox DockPanel.Dock="Right" Content="Show" IsChecked="{Binding IsApiKeyVisible}" VerticalAlignment="Center" Margin="8,0,0,0" />
                <Grid>
                    <PasswordBox x:Name="ApiKeyPasswordBox" Padding="4" PasswordChanged="OnPasswordChanged"
                                 Visibility="{Binding IsApiKeyVisible, Converter={StaticResource VisibleWhenFalse}}" />
                    <TextBox Padding="4" Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsApiKeyVisible, Converter={StaticResource VisibleWhenTrue}}" />
                </Grid>
            </DockPanel>
            <TextBlock Text="The API key must start with fz_live_" Foreground="Firebrick" Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsApiKeyRejected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <CheckBox Content="Start with _Windows" IsChecked="{Binding StartWithWindows}" Margin="0,12,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
