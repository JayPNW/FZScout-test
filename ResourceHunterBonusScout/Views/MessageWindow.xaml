<Window x:Class="ResourceHunterBonusScout.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/Active.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock x:Name="Message" TextWrapping="Wrap" />
        <Button Content="OK" IsDefault="True" IsCancel="True" MinWidth="80" Margin="0,20,0,0" HorizontalAlignment="Right" Click="OnOk" />
    </StackPanel>
</Window>
